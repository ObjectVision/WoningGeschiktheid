container OWO
{
	container system
	{
		parameter<string> emptystring := '';
		parameter<string> newline     := '\n';
	}
	#include <eenheden.dms>
	#include <klassificaties.dms>
	#include <geografie.dms>
	#include <brondata.dms>
	#include <schemas.dms>
	#include <analyses.dms>
	
	container ConfigSettings
	{
		container Overridable
		{
			parameter<string> AHNDrive := 'E:/SourceData/AHN';
		}
	}
}