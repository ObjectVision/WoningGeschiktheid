container Brondata: Using = "Eenheden;Klassificaties;Geografie"
{
	#include<AHN.dms>
	#include<BAG.dms>
	
	container Make_blad_ahn_with_bag_data // Opnieuw genereren bij nieuwe BAG of AHN data
	{
		parameter<string> generate: = 'OK', ExplicitSuppliers = "overlay;overlay/unique;bag_blad";

		unit<uint32> bag_blad := unique(Brondata/BAG/pand_met_woning/blad_grid_rel), StorageName = "%LocalDataProjDir%/bag_blad.fss"
		{

			attribute<.> bag_blad_rel (Brondata/BAG/pand_met_woning ) := rlookup(Brondata/BAG/pand_met_woning/blad_grid_rel, values), DisableStorage = "True";

			attribute<ipoint>    values;
			attribute<string>    unit                     := Geografie/blad_grid/unit[values];
			attribute<string>    name                     := Geografie/blad_grid/name[values];

			parameter<m>         buffer                   := 2[m], DisableStorage  = "True";
			attribute<m>         x_min                    := min(Brondata/BAG/pand_met_woning/bbox/x_min, bag_blad_rel) - buffer;
			attribute<m>         x_max                    := max(Brondata/BAG/pand_met_woning/bbox/x_max, bag_blad_rel) + buffer;
			attribute<m>         y_min                    := min(Brondata/BAG/pand_met_woning/bbox/y_min, bag_blad_rel) - buffer;
			attribute<m>         y_max                    := max(Brondata/BAG/pand_met_woning/bbox/y_max, bag_blad_rel) + buffer;

			unit<uint32> pointset := union_unit(., ., ., ., .), DisableStorage  = "True"
			{
				attribute<point_rd> point := union_data(.
					, point_xy(x_min, y_max, point_rd)
					, point_xy(x_max, y_max, point_rd)
					, point_xy(x_max, y_min, point_rd)
					, point_xy(x_min, y_min, point_rd)
					, point_xy(x_min, y_max, point_rd)
				);
				attribute<uint32>   sequence := id(.) % #bag_blad;
				attribute<bag_blad> ordinal  := convert(id(.) / #bag_blad, bag_blad);
			}

			attribute<point_rd> geometry      (poly) := points2Sequence(pointset/point, value(pointset/sequence, bag_blad), pointset/ordinal);
			attribute<ipoint>   geometry_ipol (poly) := ipolygon(geometry);
		}

		unit<uint32> overlay := bg_overlay_polygon(bag_blad/geometry_ipol, brondata/AHN456/blad/geometry_ipol), StorageName = "%LocalDataProjDir%/blad_overlay.fss"
		{
			attribute<string>    AHN_UNIT    := brondata/AHN456/blad/UNIT[second_rel];
			attribute<string>    BAG_UNIT    := bag_blad/UNIT[first_rel];
			attribute<bag_blad>  first_rel;
			attribute<AHN456/blad> second_rel;
			attribute<IPoint>    geometry(poly);

			unit<uint32> unique := unique(first_rel), label = "unieke AHN bladen met BAG data", StorageName = "%LocalDataProjDir%/blad_unique.fss"
			{
				attribute<string> unit := bag_blad/UNIT[values];
				attribute<uint32> Values;
			}
		}
	}

	unit<uint32> bag_blad : StorageName = "%LocalDataProjDir%/bag_blad.fss", StorageReadOnly = "True"
	{
		attribute<ipoint>    values;
		attribute<string>    unit;
		attribute<string>    name;
		//attribute<uint32>    nr_pand (AHN456/blad) := pcount(blad_rel);
		//attribute<AHN456/blad> blad_rel;

		attribute<m>         x_min;
		attribute<m>         x_max;
		attribute<m>         y_min;
		attribute<m>         y_max;

		attribute<point_rd> geometry      (poly) ;
		attribute<ipoint>   geometry_ipol (poly) := ipolygon(geometry);


	}


	unit<uint32> overlay_ahn_with_bag_data: StorageName = "%LocalDataProjDir%/blad_overlay.fss", StorageReadOnly = "True"
	{
		attribute<string>   AHN_UNIT;
		attribute<string>   BAG_UNIT;
		attribute<point_rd> lower_bound := lower_bound(geometry[point_rd]);
		attribute<point_rd> upper_bound := upper_bound(geometry[point_rd]);
		attribute<uint32>   first_rel;
		attribute<uint32>   second_rel;
		attribute<IPoint>   geometry(poly);
	}

	unit<uint32> blad_ahn_with_bag_data: StorageName = "%LocalDataProjDir%/blad_unique.fss", StorageReadOnly = "True", KeepData = "True"
	{
		attribute<string> unit;
		attribute<uint32> values;
		attribute<string> name := 'blad_' + UNIT;
	}
	
	/*unit<uint32> blad_ahn_with_bag_data: nrofrows = 2
	{
		attribute<string> unit:['02ez2','01hn1'];
		attribute<uint32> values: [0,2];
		attribute<string> name := 'blad_' + UNIT;
	}*/
	
	
	unit<uint64> pc6_pc6_weg_300m_uint64 : StorageName = "%SourceDataDir%/WoonZorgWijzer/pc6_pc6_300.fss"
	{
		attribute<string> PC6_org;
		attribute<string> PC6_dest;
		attribute<m>      impedance;
	}
	unit<uint32> pc6_pc6_weg_300m := range(uint32, 0, uint32(#pc6_pc6_weg_300m_uint64))
	{
		attribute<string>  PC6_org   := union_data(.,pc6_pc6_weg_300m_uint64/PC6_org);
		attribute<string>  PC6_dest  := union_data(.,pc6_pc6_weg_300m_uint64/PC6_dest);
		attribute<float32> impedance := union_data(.,pc6_pc6_weg_300m_uint64/impedance);
	}
	// CBS Gebiedsindelingen: levert de provinciegrenzen en de gemeente -> provincie koppeling.
	// Dit is dezelfde bron die MDAWonenZorgLimburg gebruikt.
	container CBS
	:	StorageName     = "%SourceDataDir%/CBS/2026/cbsgebiedsindelingen2026.gpkg"
	,	StorageType     = "gdal.vect"
	,	StorageReadOnly = "True"
	,	SyncMode        = "alltables"
	{
		unit<uint32> gebiedsindelingen_register;

		unit<uint32> provincie_gegeneraliseerd
		:	DialogType = "Map"
		,	DialogData = "geometry"
		{
			attribute<point_rd> geometry (poly);
		}

		unit<uint32> gemeente_niet_gegeneraliseerd
		{
			attribute<point_rd> geometry (poly);
			attribute<string>   statcode;
		}
	}

	// Studiegebied: alle gemeenten in een provincie. Verbreden/versmallen = alleen pv_code aanpassen.
	container studiegebied
	{
		parameter<string> pv_code := 'PV31';   // PV31 = Limburg

		unit<uint32> gemeente := select_with_attr_by_org_rel(CBS/gebiedsindelingen_register, CBS/gebiedsindelingen_register/pv_code == pv_code)
		{
			// gm_code wordt door select_with_attr_by_org_rel meegenomen
			attribute<string> code := substr(gm_code, 2, 4);   // 'GM0957' -> '0957', gelijk aan de eerste 4 posities van een BAG pand-id
		}

		unit<uint32> provincie := select_with_attr_by_org_rel(CBS/provincie_gegeneraliseerd, CBS/provincie_gegeneraliseerd/statcode == pv_code)
		,	DialogType = "Map"
		,	DialogData = "geometry";
	}
