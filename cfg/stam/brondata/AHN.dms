//                                                                                                  //
//           Configuratie voor het bepalen van het ongeschikt vastgoed voor ouderen                 //
//                                                                                                  //
//                           Stichting InFact & Object Vision 2018                                  //
//                                                                                                  //
//////////////////////////////////////////////////////////////////////////////////////////////////////
//                                                                                                  //
//                          Configuratiebestand met AHN brondata                                    //
//                                                                                                  //
//////////////////////////////////////////////////////////////////////////////////////////////////////

container AHN
{
	unit<uint32> blad_src:
		StorageName     = "%SourceDataDir%/AHN/ahn_units.shp"
	,	StorageType     = "gdal.vect"
	,	StorageReadOnly = "True"
	,	DialogData      = "geometry_rd"
	,	DialogType      = "Map"
	{
		attribute<fpoint>   geometry    (poly);
		attribute<point_rd> geometry_rd (poly) := geometry[point_rd]; // truc voor issue 855, weer wegwerken als is opgelost.
		attribute<point_rd> centroid           := centroid(geometry_rd);
		attribute<bool>     foute_10dz2        := blad_src/UNIT == '10dz2' && uint32(pointCol(blad_src/centroid)) == 152500 && uint32(pointRow(blad_src/centroid)) == 553125;
	}

	unit<uint32> blad := Subset(!blad_src/foute_10dz2) // 10dz2 is dubbel,geeft problemen later in de verwerking dus de unit met geen BAG data verwijderen.
	,	DialogType = "Map"
	,	DialogData = "geometry"
	{
		attribute<point_rd> geometry      (poly) := blad_src/geometry_rd[nr_OrgEntity];
		attribute<ipoint>   geometry_ipol (poly) := ipolygon(blad_src/geometry[nr_OrgEntity]);

		attribute<string>   unit                 := blad_src/unit[nr_OrgEntity];
		attribute<string>   name                 := 'blad_' + unit;

		attribute<Geografie/blad_grid/domain> blad_grid_rel := centroid(geometry)[Geografie/blad_grid/domain];

		attribute<string> int_filename_AHN2 := expand(., '%AHNDrive%') + '/AHN_2_cm/i' + substr(unit, 0, 2) + '/' + substr(unit, 2, 3) + '.tif';
		attribute<string> int_filename_AHN3 := replace(int_filename_AHN2, 'AHN_2_cm', 'AHN_3_cm');

		attribute<string> ruw_filename_AHN2 := replace(int_filename_AHN2, 'AHN_2_cm/i', 'AHN_2_cm/r');
		attribute<string> ruw_filename_AHN3 := replace(ruw_filename_AHN2, 'AHN_2_cm'  , 'AHN_3_cm');

		attribute<string> int_filename      := ='union_data(.,' + AsList('ExistingFiles/per_blad/' + name + '/int_filename',',') + ')', KeepData = "True", StoreData = "True";
		attribute<string> ruw_filename      := ='union_data(.,' + AsList('ExistingFiles/per_blad/' + name + '/ruw_filename',',') + ')', KeepData = "True", StoreData = "True";

		attribute<bool>   heeftAHN2data     := isNull(strpos(int_filename,'missing')) &&  isNull(strpos(ruw_filename,'missing'));
		attribute<bool>   heeftAHN3data     := strpos(int_filename,'AHN_3') > 0 && strpos(ruw_filename,'AHN_3') > 0; //&& unit <> '06fn1';
		attribute<bool>   heeftAHN3data_int := strpos(int_filename,'AHN_3') > 0 ;
		attribute<bool>   heeftAHN3data_ruw := strpos(ruw_filename,'AHN_3') > 0 ;
		

		attribute<jaar>   inwinjaar_AHN2    := rjoin(id(.), inwinjaren/intersect_AHN2/first_rel, inwinjaren/intersect_AHN2/inwinjaar_AHN2), KeepData = "True", StoreData = "True";
		attribute<string> inwinjaar_AHN3_str:= heeftAHN3data ?
			isNull(rlookup(unit, Brondata/AHN/inwinjaren/AHN3/gedownload_voor_2018/unit))
				? '2016'
				: '2014_2015'
			: String(0 / 0)
		, KeepData = "True", StoreData = "True";

		container ExistingFiles
		{
			container per_blad := for_each_ne
			(
				  name
				,'schemas/bepaal_existing_files(' + string(id(blad)) + ')'
			);
		}

		container inwinjaren
		{
			unit<uint32> intersect_AHN2 := overlay_polygon(ipolygon(blad/geometry), ipolygon(inwinjaren_AHN2/geometry_rd))
			{
				attribute<jaar> inwinjaar_AHN2 := inwinjaren_AHN2/inwinjaar[second_rel];
			}
		}
		
		unit<uint32> WelAHN3IntGeenRuw := Subset(blad/heeftAHN3data_int && !blad/heeftAHN3data_ruw)
		,	DialogType = "Map"
		,	DialogData = "geometry"
		{
			attribute<point_rd> geometry      (poly) := blad/geometry[nr_OrgEntity];
			attribute<string>   unit                 := blad/unit[nr_OrgEntity];
		}
	}

	unit<uint32> blad_AHN2 := Subset(blad/heeftAHN2data)
	,	DialogType = "Map"
	,	DialogData = "geometry"
	,	FreeData   = "False"
	{
		attribute<point_rd> geometry      (poly) := blad/geometry[nr_OrgEntity];
		attribute<ipoint>   geometry_ipol (poly) := blad/geometry_ipol[nr_OrgEntity];

		attribute<string>   unit                 := blad/unit[nr_OrgEntity];
		attribute<string>   name                 := blad/name[nr_OrgEntity];
		
		attribute<string>   int_filename         := blad/int_filename_AHN2[nr_OrgEntity];
		attribute<string>   ruw_filename         := blad/ruw_filename_AHN2[nr_OrgEntity];
	}

	unit<uint32> blad_AHN3 := Subset(blad/heeftAHN3data)
	,	DialogType = "Map"
	,	DialogData = "geometry"
	,	FreeData   = "False"
	{
		attribute<point_rd> geometry      (poly) := blad/geometry[nr_OrgEntity];
		attribute<ipoint>   geometry_ipol (poly) := blad/geometry_ipol[nr_OrgEntity];

		attribute<string>   unit                 := blad/unit[nr_OrgEntity];
		attribute<string>   name                 := blad/name[nr_OrgEntity];
		
		attribute<string>   int_filename         := blad/int_filename_AHN3[nr_OrgEntity];
		attribute<string>   ruw_filename         := blad/ruw_filename_AHN3[nr_OrgEntity];
	}

	unit<uint32> blad_Test := Subset(blad/heeftAHN2data && id(blad) > 200 && id(blad) < 251) 
	,	DialogType = "Map"
	,	DialogData = "geometry"
	,	FreeData   = "False"
	{
		attribute<point_rd> geometry      (poly) := blad/geometry[nr_OrgEntity];
		attribute<ipoint>   geometry_ipol (poly) := blad/geometry_ipol[nr_OrgEntity];

		attribute<string>   unit                 := blad/unit[nr_OrgEntity];
		attribute<string>   name                 := blad/name[nr_OrgEntity];
		
		attribute<string>   int_filename         := blad/int_filename_AHN2[nr_OrgEntity];
		attribute<string>   ruw_filename         := blad/ruw_filename_AHN2[nr_OrgEntity];
	}

	unit<uint32> inwinjaren_AHN2:
		StorageName = "%SourceDataDir%/AHN/inwinjaren_AHN2_def.shp"
	,	StorageType = "gdal.vect"
	{
		attribute<fpoint>   geometry    (poly);
		attribute<point_rd> geometry_rd (poly) := geometry[point_rd], DisableStorage = "True"; // truc voor issue 855, weer wegwerken als is opgelost.
		attribute<jaar> inwinjaar;
	}

	container readDomainsAHN2    := readDomainsTemplate(blad_AHN2);
	container readDomainsAHN3    := readDomainsTemplate(blad_AHN3);
	container readDomainsAHNTest := readDomainsTemplate(blad_test);

	Template readDomainsTemplate
	{
		// begin case parameter
		container src;
		// end case parameter

		unit<uint32> overlay := overlay_polygon(Analyses/Geschiktheid/pand_met_woning/impl/blad/geometry_ipol, ipolygon(src/Geometry))
		{
			attribute<string>   AHN_UNIT    := src/UNIT[second_rel];
			attribute<string>   BAG_UNIT    := Analyses/Geschiktheid/pand_met_woning/impl/blad/UNIT[first_rel];
			attribute<point_rd> lower_bound := lower_bound(geometry[point_rd]);
			attribute<point_rd> upper_bound := upper_bound(geometry[point_rd]);
		}
		unit<uint32> bag_blad := unique(overlay/first_rel)
		{
			attribute<string> unit := Analyses/Geschiktheid/pand_met_woning/impl/blad/UNIT[values];
			attribute<string> name := 'blad_' + UNIT;
		}
	}
	container AHN2 := Schemas/ahn_set_to_BAG_perspectieven/stam(readDomainsAHN2, Brondata/AHN/blad_AHN2);
	container AHN3 := Schemas/ahn_set_to_BAG_perspectieven/stam(readDomainsAHN3, Brondata/AHN/blad_AHN3);
	
	container inwinjaren
	{
		container AHN3
		{
			/*unit<uint32> gedownload_voor_2018_src:
				StorageName     = "C:/sourcedata/AHN_3_cm_2017/ahn3_2017.csv"
			,	StorageType     = "gdal.vect"
			,	StorageReadOnly = "True"
			{
				unit<uint32> ruw_tif := Subset(strcount(gedownload_voor_2018/blad, '\\r') > 0 && strcount(gedownload_voor_2018/blad, 'tif') > 0)
				{
					attribute<string> blad_ruw := gedownload_voor_2018/blad[nr_OrgEntity];
					attribute<string> unit := replace(replace(blad_ruw, 'C:\\sourcedata\\AHN_3_cm_2017\\r',''),'\\','','.tif','');
				}
			}*/
			unit<uint32> gedownload_voor_2018: nrofrows = 509
			{
				attribute<string> unit :
					['01cz1','01cz2','01dz1','01dz2','01gn1','01gn2','01gz1','01gz2','01hn1','01hn2','01hz1','01hz2','02cn1','02cn2','02cz1','02cz2','02dn1','02dz1','02dz2','02ez1','02ez2','02fz1','02fz2','02gn1','02gn2','02gz1','02gz2','02hn1','02hn2','03az1','04dn2','04dz2','04ez2','04fn2','04fz1','04fz2','04gn1','04gn2','04gz1','05an1','05an2','05bn1','05dn2','05dz2','05ez2','05fn1','05fn2','05fz1','05fz2','05gn1','05gn2','05gz1','05gz2','05hn1','05hn2','05hz1','05hz2','06an1','06an2','06az1','06az2','06bn1','06bn2','06bz1','06bz2','06cn1','06cn2','06cz1','06cz2','06dn1','06dn2','06dz1','06dz2','06en1','06en2','06ez1','06ez2','06fn1','06fn2','06fz1','06fz2','06gn1','06gn2','06gz1','06gz2','06hn1','06hn2','06hz1','06hz2','09hn2','09hz1','09hz2','10az2','10bn1','10bn2','10bz1','10bz2','10cn1','10cn2','10dn1','10dn2','10dz2','10en1','10en2','10ez1','10ez2','10fn1','10fn2','10fz1','10fz2','10gz2','10hn1','10hn2','10hz1','10hz2','11an1','11an2','11az1','11az2','11bn1','11bn2','11bz1','11bz2','11cn1','11cn2','11cz1','11cz2','11dn1','11dn2','11dz1','11dz2','11en1','11en2','11ez1','11ez2','11fn1','11fn2','11fz1','11fz2','11gn1','11gn2','11gz1','11gz2','11hn1','11hn2','11hz1','11hz2','12az1','12cn1','12cz1','14fn1','15bn1','15bn2','15bz1','15bz2','15en1','15en2','15ez1','15ez2','15fn1','15fn2','15fz1','15fz2','16an1','16an2','16az1','16az2','16bn1','16bn2','16bz1','16bz2','16cn1','16cn2','16dn1','16dn2','16en1','16en2','16ez1','16ez2','16fn1','16fn2','17an1','24fn2','24fz2','24hn1','24hn2','24hz1','24hz2','25an1','25an2','25az1','25az2','25bn1','25bn2','25bz1','25bz2','25cn1','25cn2','25cz1','25cz2','25dn1','25dn2','25dz1','25dz2','25ez1','25ez2','25gn1','25gn2','25gz1','25gz2','25hn1','25hn2','25hz1','25hz2','26cz1','26cz2','26dz1','30dn2','30dz1','30dz2','30en2','30ez1','30ez2','30fn1','30fn2','30fz1','30fz2','30gn1','30gn2','30gz1','30gz2','30hn1','30hn2','30hz1','30hz2','31an1','31an2','31az1','31az2','31bn1','31bn2','31bz1','31bz2','31cn1','31cn2','31cz1','31cz2','31dn1','31dn2','3