//                                                                                                  //
//           Configuratie voor het bepalen van het ongeschikt vastgoed voor ouderen                 //
//                                                                                                  //
//                           Stichting InFact & Object Vision 2018                                  //
//                                                                                                  //
//////////////////////////////////////////////////////////////////////////////////////////////////////
//                                                                                                  //
//                          Configuratiebestand met AHN brondata                                    //
//                                                                                                  //
//////////////////////////////////////////////////////////////////////////////////////////////////////

container AHN456
{
// Tegel-index en rasters komen uit de voorgecombineerde AHN4+AHN5+AHN6 set.
// De AHN6 > AHN5 > AHN4 fallback zit al in de tif's (zie prj/AHN_2_AHN_cm/scripts/combine_AHN4_AHN5_AHN6_to_uint16.py);
// <cell>_src.tif bevat per cel de gebruikte AHN-versie (4/5/6, 0 = geen bron).

	parameter<string> AHN_version := 'AHN4_AHN5_AHN6';

	unit<uint32> blad
	:	StorageName     = "='%AHNDrive%/' + AHN_version + '_combination.gpkg'"
	,	StorageType     = "gdal.vect"
	,	StorageReadOnly = "True"
	,	KeepData        = "True"
	,	DialogType      = "Map"
	,	DialogData      = "geometry"
	{
		attribute<point_rd> geometry (poly);
		attribute<string>   name;                                     // 'cell_<i>_<j>'
		attribute<string>   unit                 := name;              // owo-vocabulaire: 'unit' is de bladnaam
		attribute<ipoint>   geometry_ipol (poly) := ipolygon(geometry);

		attribute<Geografie/blad_grid/domain> blad_grid_rel := centroid(geometry)[Geografie/blad_grid/domain];

		attribute<string> ruw_filename := expand(., '%AHNDrive%') + '/' + AHN_version + '/DSM/' + name + '_05m.tif';
		attribute<string> int_filename := expand(., '%AHNDrive%') + '/' + AHN_version + '/DTM/' + name + '_05m.tif';
		attribute<string> src_filename := expand(., '%AHNDrive%') + '/' + AHN_version + '/DSM/' + name + '_src.tif';
	}

	container inwinjaren_AHN
	{
		unit<uint32> P1_RegioWest2020_v2: StorageName = "D:/SourceData/AHN/AHN4/inwinjaren/P1_RegioWest2020_v2"
		, StorageType = "gdal.vect"
		, StorageReadOnly = "True";

		unit<uint32> P2_RegioNoord2020_v2: StorageName = "D:/SourceData/AHN/AHN4/inwinjaren/P2_RegioNoord2020_v2"
		, StorageType = "gdal.vect"
		, StorageReadOnly = "True";

		unit<uint32> P2_RegioOost2022_v2: StorageName = "D:/SourceData/AHN/AHN4/inwinjaren/P2_RegioOost2022_v2"
		, StorageType = "gdal.vect"
		, StorageReadOnly = "True";

		unit<uint32> P2_RegioZuid2021_v2: StorageName = "D:/SourceData/AHN/AHN4/inwinjaren/P2_RegioZuid2021_v2"
		, StorageType = "gdal.vect"
		, StorageReadOnly = "True";

		unit<uint32> P2_RegioZuidWest2020_v2: StorageName = "D:/SourceData/AHN/AHN4/inwinjaren/P2_RegioZuidWest2020_v2"
		, StorageType = "gdal.vect"
		, StorageReadOnly = "True";

		unit<uint32> yr2020 := union_unit(P1_RegioWest2020_v2,P2_RegioNoord2020_v2,P2_RegioZuidWest2020_v2)
		{
			attribute<point_rd> geometry (poly) := union_data(., P1_RegioWest2020_v2/geometry, P2_RegioNoord2020_v2/geometry, P2_RegioZuidWest2020_v2/geometry)[point_rd];
		}
		unit<uint32> yr2021 := P2_RegioZuid2021_v2
		{
			attribute<point_rd> geometry (poly) := P2_RegioZuid2021_v2/geometry[point_rd];
		}
		unit<uint32> yr2022 := P2_RegioOost2022_v2
		{
			attribute<point_rd> geometry (poly) := P2_RegioOost2022_v2/geometry[point_rd];
		}
		unit<uint32> totaal := union_unit(yr2020, yr2021, yr2022)
		{
			attribute<point_rd> geometry (poly) := union_data(., yr2020/geometry, yr2021/geometry, yr2022/geometry);
			attribute<uint16>   inwinjaar       := union_data(., const(uint16(2020),yr2020), const(uint16(2021),yr2021), const(uint16(2022),yr2022));
		}
	}
}