7fz2','67gn1','67gn2','67gz1','67gz2','67hn1','67hn2','67hz1','67hz2','70fz2'];
			}
			/*
			unit<uint32> gedownload_in_2018:
				StorageName     = "C:/sourcedata/AHN_3_cm/ahn3_2018.csv"
			,	StorageType     = "gdal.vect"
			,	StorageReadOnly = "True"
			{
				unit<uint32> ruw_tif := Subset(strcount(gedownload_in_2018/blad, '\\r') > 0 && strcount(gedownload_in_2018/blad, 'tif') > 0)
				{
					attribute<string> blad_ruw := gedownload_in_2018/blad[nr_OrgEntity];
					attribute<string> unit := replace(replace(blad_ruw, 'C:\\sourcedata\\AHN_3_cm\\r',''),'\\','','.tif','');
				}
			}*/
			unit<uint32> gedownload_in_2018: nrofrows = 761
			{
				attribute<string> unit :
