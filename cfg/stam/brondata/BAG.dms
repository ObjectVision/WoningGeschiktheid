//                                                                                                  //
//           Configuratie voor het bepalen van het ongeschikt vastgoed voor ouderen                 //
//                                                                                                  //
//                           Stichting InFact & Object Vision 2018                                  //
//                                                                                                  //
//////////////////////////////////////////////////////////////////////////////////////////////////////
//                                                                                                  //
//                  Configuratiebestand met brondata > vastgoed > BAG                               //
//                  Data wordt gelezen uit een snapshot die met de BAG                              //
//                  verwerkingsscripts gemaakt zijn gemaakt                                         //
//                                                                                                  //
//////////////////////////////////////////////////////////////////////////////////////////////////////

container BAG
{
//	parameter<string> snapshotdate := '20180701';
	parameter<string> snapshotdate := '20230701';

//	parameter<string> snapshotdir  := '%SourceDataDir%/BAG/snapshots.ext/GrootNH/' + snapshotdate;
	parameter<string> snapshotdir  := 'D:/SourceData/BAG20/snapshots.ext/' + snapshotdate;

	container impl
	{
		parameter<string> ligplaats_src_name        := snapshotdir + '/ligplaats.fss'; 
		parameter<string> standplaats_src_name      := snapshotdir + '/standplaats.fss'; 
		parameter<string> pand_src_name             := snapshotdir + '/pand.fss'; 
		parameter<string> vbo_src_name              := snapshotdir + '/vbo.fss'; 
		parameter<string> nummeraanduiding_src_name := snapshotdir + '/nummeraanduiding.fss'; 
		parameter<string> openbareruimte_src_name   := snapshotdir + '/openbareruimte.fss'; 
		parameter<string> woonplaats_src_name       := snapshotdir + '/woonplaats.fss'; 
		parameter<string> adres_src_name            := snapshotdir + '/adres.fss'; 
	}

	unit<uint32> vbo_import
	: StorageName     = "= impl/vbo_src_name"
	, StorageReadOnly = "True"
	, SyncMode        = "None"
	{
		attribute<string>      identificatie;

		attribute<point_rd_mm> geometry_mm;
		attribute<point_rd>    geometry := geometry_mm[point_rd];

		attribute<int32>       oppervlakte;
		attribute<string>      nummeraanduiding_id;
		attribute<string>      postcode := rjoin(nummeraanduiding_id, adres/nummeraanduiding_id, adres/postcode);
		attribute<string>      pand_id_geom;
		attribute<pand>        pand_rel := rlookup(pand_id_geom, pand/identificatie);

		container gebruiksdoelen :=
			for_each_ndv(
				co/gebruiksdoel_vbo/name
				, .
				, bool
			)
		{
			attribute<bool> alle (vbo) := =AsList(co/gebruiksdoel_vbo/name, ' && ');
		}
		attribute<string>      gemeentecode := substr(identificatie,0,4);
		attribute<Brondata/pc6_pc6_weg_300m> pc6_pc6_weg_300m_rel:= rlookup(postcode, Brondata/pc6_pc6_weg_300m/PC6_org);
		
		attribute<nummeraanduiding> nummeraanduiding_rel := rlookup(nummeraanduiding_id, nummeraanduiding/identificatie);
	}

	unit<uint32> vbo := select_with_attr_by_org_rel(vbo_import, isDefined(vbo_import/geometry))
	{
		container gebruiksdoelen :=
			for_each_nedv(
				co/gebruiksdoel_vbo/name
				,'vbo_import/gebruiksdoelen/' + co/gebruiksdoel_vbo/name + '[org_rel]'
				, .
				, bool
			)
		{
			attribute<bool> alle (vbo) := =AsList(co/gebruiksdoel_vbo/name, ' && ');
		}
	}

	unit<uint32> nummeraanduiding: StorageName     = "= impl/nummeraanduiding_src_name"
	{
		attribute<string> identificatie;

		attribute<int32>  huisnummer;
		attribute<string> huisletter;
		attribute<string> toevoeging;
		attribute<string> postcode;
		attribute<bool>   postcodeBevatSpecifiekeLetters:=
			strcount(uppercase(postcode),'F')  > 0
		||	strcount(uppercase(postcode),'I')  > 0
		||	strcount(uppercase(postcode),'O')  > 0
		||	strcount(uppercase(postcode),'Q')  > 0
		||	strcount(uppercase(postcode),'U')  > 0
		||	strcount(uppercase(postcode),'Y')  > 0
		||	strcount(uppercase(postcode),'SA') > 0
		||	strcount(uppercase(postcode),'SD') > 0
		||	strcount(uppercase(postcode),'SS') > 0;

		attribute<string> typeAdresseerbaarObject;
		attribute<string> openbareruimte_id;

		attribute<string> pht:= postcode + '_' + string(huisnummer) + '_' + huisletter + '_' + toevoeging, DisableStorage = "True";
		
		attribute<bool> heeft_woonfunctie := any(vbo_import/gebruiksdoelen/woon, vbo_import/nummeraanduiding_rel);
	}

	unit<uint32> openbareruimte
	:	StorageName     = "= impl/openbareruimte_src_name"
	,	StorageReadOnly = "True"
	,	SyncMode        = "None"
	{
		attribute<string> identificatie;

		attribute<string> naam;
		attribute<string> type;
		attribute<string> woonplaats_id;
	}

	unit<uint32> woonplaats
	:	StorageName     = "= impl/woonplaats_src_name"
	,	StorageReadOnly = "True"
	,	SyncMode        = "None"
	,	DialogType      = "Map"
	,	DialogData      = "geometry"
	{
		attribute<string>      identificatie;

		attribute<point_rd_mm> geometry_mm (poly);
		attribute<point_rd>    geometry    (poly) := geometry_mm[point_rd];

		attribute<string>      woonplaatsNaam;
	}

	unit<uint32> pand
	:	StorageName     = "= impl/pand_src_name"
	,	StorageReadOnly = "True"
	,	SyncMode        = "None"
	,	DialogType      = "Map"
	,	DialogData      = "geometry"
	{
		attribute<string>          identificatie;

		attribute<point_rd_mm>     geometry_mm    (poly);
		attribute<point_rd>        geometry       (poly) := geometry_mm[point_rd];

		attribute<eenheden/jaar>   bouwjaar;
		attribute<co/pandtype_geo> woonpand_type;

		container meta
		{
			attribute<string> status     (pand);
			attribute<int32>  begindatum (pand);
			attribute<int32>  einddatum  (pand);
		}

		attribute<m2>     sum_vbo_oppervlaktes      := sum(vbo/oppervlakte[m2], vbo/pand_rel);
		attribute<m2>     sum_vbo_woon_oppervlaktes := sum(vbo/gebruiksdoelen/woon ? vbo/oppervlakte[m2] : 0[m2], vbo/pand_rel);
		attribute<uint32> nr_vbo                    := pcount(vbo/pand_rel);

		attribute<uint32> nr_woningen               := sum(vbo/gebruiksdoelen/woon   ? 1 : 0, BAG/vbo/pand_rel);

		attribute<bool>   test_inAmstelveen         := woonplaats/woonplaatsNaam[point_in_polygon(centroid(geometry), woonplaats/geometry)] == 'Amstelveen';
		attribute<bool>   heeft_woningen            := nr_woningen > 0;// && test_inAmstelveen;
		attribute<bool>   is_meergezins             := nr_woningen > 1;

		attribute<uint32> nr_winkels                := sum(vbo/gebruiksdoelen/winkel ? 1 : 0, vbo/pand_rel);
		attribute<bool>   heeft_winkel              := nr_winkels > 0;

		attribute<bool>   heeft_zorg                := any(vbo/gebruiksdoelen/gezondheidszorg , vbo/pand_rel);
		attribute<bool>   heeft_bijeenkomst         := any(vbo/gebruiksdoelen/bijeenkomst,      vbo/pand_rel);
		attribute<bool>   heeft_overige_functie     := any(vbo/gebruiksdoelen/overige_gebruiks, vbo/pand_rel);

		attribute<string> adres_range               := AsItemList(adres/uniquePCperPand/adres_range, adres/uniquePCperPand/pand_rel);
		attribute<string> postcode                  := AsItemList(adres/uniquePCperPand/postcode, adres/uniquePCperPand/pand_rel);

		container bbox
		{
			attribute<point_rd> lb (..) := lower_bound(geometry);
			attribute<point_rd> ub (..) := upper_bound(geometry);
			attribute<m> dx        (..) := pointCol(ub)[m] - pointCol(lb)[m];
			attribute<m> dy        (..) := pointRow(ub)[m] - pointRow(lb)[m];

			attribute<m> x_min     (..) := PointCol(lb)[m];
			attribute<m> x_max     (..) := PointCol(ub)[m];
			attribute<m> y_min     (..) := PointRow(lb)[m];
			attribute<m> y_max     (..) := PointRow(ub)[m];
		}
	}
	unit<uint32> pand_met_woning := select_with_attr_by_cond(pand, pand/heeft_woningen)
	{
		container bbox
		{
			attribute<point_rd> lb (..) := lower_bound(geometry);
			attribute<point_rd> ub (..) := upper_bound(geometry);
			attribute<m> dx        (..) := pointCol(ub)[m] - pointCol(lb)[m];
			attribute<m> dy        (..) := pointRow(ub)[m] - pointRow(lb)[m];

			attribute<m> x_min     (..) := PointCol(lb)[m];
			attribute<m> x_max     (..) := PointCol(ub)[m];
			attribute<m> y_min     (..) := PointRow(lb)[m];
			attribute<m> y_max     (..) := PointRow(ub)[m];
		}
		attribute<point_rd>                   centroid      := point(bbox/x_min + 0.5f * bbox/dx, bbox/y_min + 0.5f * bbox/dy, point_rd); // de centroid_or_mid geeft incorrecte resultaten voor sommige geometrieen.

		attribute<Geografie/blad_grid/domain> blad_grid_rel := centroid[Geografie/blad_grid/domain];
		attribute<Brondata/bag_blad>          blad_rel      := rlookup(blad_grid_rel, Brondata/bag_blad/values);
		attribute<AHN4/blad>                  blad_src_rel  := point_in_polygon(centroid, Brondata/AHN4/blad/geometry);
	}

	unit<uint32> adres
	:	StorageName     = "= impl/adres_src_name"
	,	StorageReadOnly = "True"
	,	SyncMode        = "None"
	,	DialogType      = "Map"
	,	DialogData      = "geometry"
	{
		attribute<point_rd>          geometry;
		attribute<string>            nummeraanduiding_id;
		attribute<string>            straatnaam;
		attribute<string>            postcode;
		attribute<int32>             huisnummer;
		attribute<string>            huisletter;
		attribute<string>            toevoeging;
		attribute<string>            woonplaatsnaam;
		
		attribute<bool>              heeft_woonfunctie := rjoin(nummeraanduiding_id, nummeraanduiding/identificatie, nummeraanduiding/heeft_woonfunctie);
		
		attribute<vbo>               vbo_rel   := rlookup(nummeraanduiding_id, vbo/nummeraanduiding_id);
		attribute<pand>              pand_rel  := vbo/pand_rel[vbo_rel];
		attribute<string>            PCperPand := postcode + '_' + string(pand_rel);

		attribute<uniquePCperPand>   uniquePCperPand_Rel := rlookup(PCperPand, uniquePCperPand/values);

		unit<uint32> uniquePCperPand := unique(PCperPand)
		{
			attribute<string> postcode        := substr(values, 0, strpos(values,'_'));
			attribute<pand>   pand_rel        := substr(values, strpos(values,'_') +1 )[pand];
			attribute<string> straatnaam      := rjoin(values, adres/PCperPand, adres/straatnaam);
			attribute<int32>  hnr_min         := min(huisnummer,uniquePCperPand_rel);
			attribute<int32>  hnr_max         := max(huisnummer,uniquePCperPand_rel);
			attribute<string> woonplaatsnaam  := first(adres/woonplaatsnaam, uniquePCperPand_rel);

			attribute<string> adres_range     := woonplaatsnaam + ' ' + straatnaam + ' '+ postcode + ' hnr: ' + string(hnr_min) + ' - ' + string(hnr_max);
		}
	}

	/*unit<uint32> adres_NH := Subset(isDefined(point_in_polygon(adres/geometry, NH/Geometry )))
	,	DialogType      = "Map"
	,	DialogData      = "geometry"
	{
		attribute<point_rd> geometry := adres/geometry[nr_OrgEntity];
		attribute<string>   postcode := adres/postcode[nr_OrgEntity];
	}*/


}