//////////////////////////////////////////////////////////////////////////////////////////////////////

template ahn_merge
{
	// begin case parameters
	parameter<string> AHNSet;
	unit<uint32> bladen;
	// end case paremeters

	container per_blad :=
		for_each_ne(
			 bladen/name
			,'lees_ahn_blad(' + quote(bladen/unit) + ')'
		)
	{
		template lees_ahn_blad
		{
			// begin case parameters
			parameter<string> unit;
			// end case parameters

			unit<uint32> pand_met_woning: StorageName = "='%LocalDataProjDir%/bladen/' + AHNSet + '/pand_met_woning/' + unit + '.fss'"
			{
				attribute<string>    identificatie            ;
				attribute<cm_uint16> hoogte                   ;
				attribute<cm_uint16> hoogte_nok               ;
				attribute<cm_uint16> hoogte_maaiveld_offset   ;
				attribute<uint8>     bouwlagen_ahn            ;
				attribute<float32>   perc_vlak                ;
				attribute<bool>      heeftMogelijkLiftschacht ;
				attribute<uint8>     ahn_bron                 ;
			}
		}
	}

	unit<uint32> pand_met_woning_plus := ='union_unit(' + asItemList('per_blad/' + bladen/name + '/pand_met_woning') + ')'
	,	StorageName = "='%LocalDataProjDir%/' + AHNSet + '/pand_met_woning.fss'"
	{
		attribute<string>    identificatie            := ='union_data(.,' + asItemList('per_blad/' + bladen/name + '/pand_met_woning/identificatie') + ')';
		attribute<cm_uint16> hoogte                   := ='union_data(.,' + asItemList('per_blad/' + bladen/name + '/pand_met_woning/hoogte') + ')';
		attribute<cm_uint16> hoogte_nok               := ='union_data(.,' + asItemList('per_blad/' + bladen/name + '/pand_met_woning/hoogte_nok') + ')';
		attribute<cm_uint16> hoogte_maaiveld_offset   := ='union_data(.,' + asItemList('per_blad/' + bladen/name + '/pand_met_woning/hoogte_maaiveld_offset') + ')';
		attribute<uint8>     bouwlagen_ahn            := ='union_data(.,' + asItemList('per_blad/' + bladen/name + '/pand_met_woning/bouwlagen_ahn') + ')';
		attribute<float32>   perc_vlak                := ='union_data(.,' + asItemList('per_blad/' + bladen/name + '/pand_met_woning/perc_vlak') + ')';
		attribute<bool>      heeftMogelijkLiftschacht := ='union_data(.,' + asItemList('per_blad/' + bladen/name + '/pand_met_woning/heeftMogelijkLiftschacht') + ')';
		attribute<uint8>     ahn_bron                 := ='union_data(.,' + asItemList('per_blad/' + bladen/name + '/pand_met_woning/ahn_bron') + ')';
	}
}