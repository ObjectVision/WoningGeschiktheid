//        Configuratie voor het genereren van vastgoed informatie voor EDM                             //
//                                                                                                     //
//                              Object Vision 2017                                                     //
//                                                                                                     //
/////////////////////////////////////////////////////////////////////////////////////////////////////////
//                                                                                                     //
// Configuratiebestand met schem om een AHN set(2/3) in te lezen (met verschillende BAG perspectieven) //
//                                                                                                     //
/////////////////////////////////////////////////////////////////////////////////////////////////////////

Container ahn_set_to_BAG_perspectieven
{
	template stam
	{
		// begin case parameters
		container readDomains;
		unit<uint32> blad_AHN;
		// end case parameters

		unit<uint32> blad := unique(readDomains/overlay/second_rel), label = "unieke AHN bladen met BAG data"
		{
			attribute<string> name := blad_AHN/name[values];
		}

		container per_blad := for_each_ne(
			 blad/name
			,'bepaal_BAG_perspectief_griddomeinen_en_lees_data_per_blad(blad_AHN,' + string(blad/values) + ')'
		);
	}

	template bepaal_BAG_perspectief_griddomeinen_en_lees_data_per_blad
	{
		// begin case parameters
		unit<uint32> blad_AHN;
		parameter<blad_AHN> blad_AHN_rel;
		//

		parameter<string> unit := blad_AHN/unit[blad_AHN_rel];

		unit<uint32> readDomainsBlad := Subset(readDomains/overlay/second_rel == blad_AHN_rel)
		{
			attribute<Analyses/Geschiktheid/pand_met_woning/impl/blad> pand_met_woning_rel := readDomains/overlay/first_rel[nr_OrgEntity];
			attribute<string>                                          unit                :=  Analyses/Geschiktheid/pand_met_woning/impl/blad/unit[pand_met_woning_rel];
			attribute<string>                                          name                := 'blad_' + unit;

			attribute<point_rd>                                        lowerbound          := readDomains/overlay/lower_bound[nr_OrgEntity];
			attribute<point_rd>                                        upperbound          := readDomains/overlay/upper_bound[nr_OrgEntity];

			attribute<m>                                               minX                := PointCol(lowerbound)[m];
			attribute<m>                                               maxX                := PointCol(upperbound)[m];
			attribute<m>                                               minY                := PointRow(lowerbound)[m];
			attribute<m>                                               maxY                := PointRow(upperbound)[m];
		}

		container perReadDomainSrc :=
			for_each_ne(
				 readDomainsBlad/name
				,'bepaal_BAG_perspectief_griddomein(' 
					       + string(readDomainsBlad/minX) + 
					'[m],' + string(readDomainsBlad/maxX) + 
					'[m],' + string(readDomainsBlad/minY) + 
					'[m],' + string(readDomainsBlad/maxY) 
				+ '[m])'
			);

		container perReadDomain := for_each_nex(readDomainsBlad/name, 'perReadDomainSrc/' + readDomainsBlad/name + '/grid/domain', spoint); // constructie om het domein als diret subitem te krijgen 

		parameter<string> int_filename := blad_AHN/int_filename[blad_AHN_rel];
		parameter<string> ruw_filename := blad_AHN/ruw_filename[blad_AHN_rel];

		container int := lees_data_per_blad(int_filename, readDomainsBlad, perReadDomain);
		container ruw := lees_data_per_blad(ruw_filename, readDomainsBlad, perReadDomain);
	}

	template bepaal_BAG_perspectief_griddomein
	{
		parameter<m> xmin;
		parameter<m> xmax;
		parameter<m> ymin;
		parameter<m> ymax;

		container blad
		{
			parameter<m> x_min := xmin;
			parameter<m> x_max := xmax;
			parameter<m> y_min := ymin;
			parameter<m> y_max := ymax;
		}
		container grid := Schemas/define_grid(0.5[m], 0.5[m], blad);
	}

	template lees_data_per_blad
	{
		// begin case parameters
		parameter<string> filename;
		unit<uint32> readdomains;
		container perReadDomain;
		// end case parameters

		unit<spoint> grid
		:	StorageName     = "=filename"
		,	StorageType     = "gdal.grid"
		,	DialogData      = "point_rd"
		,	StorageReadOnly = "True"
	{
			container BAGPerspectieven :=
				for_each_ndnv(
					  readdomains/name
					, perReadDomain
					, readdomains/name
					, cm_uint16
					);
		}
	}
}